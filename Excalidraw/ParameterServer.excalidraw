      "text": "F. Fault tolerance",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "F. Fault tolerance",
      "autoResize": true,
